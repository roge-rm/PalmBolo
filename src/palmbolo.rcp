#include "resource.h"

VERSION ID 1 kAppVersion

FORM ID TitleForm AT (0 0 160 160)
NOFRAME
USABLE
MENUID MainMenu
BEGIN
  BUTTON "Resume" ID TitleResume AT (4 113 74 14) RECTFRAME USABLE
  BUTTON "New game" ID TitleNew AT (82 113 74 14) RECTFRAME USABLE
  BUTTON "Join game" ID TitleJoin AT (4 130 74 14) RECTFRAME USABLE
  BUTTON "Settings" ID TitleSettings AT (82 130 74 14) RECTFRAME USABLE
END

FORM ID MapListForm AT (0 0 160 160)
USABLE
MENUID MapMenu
BEGIN
  TITLE "Choose a map"
  LIST "" ID MapList AT (7 96 146 33) VISIBLEITEMS 3
  BUTTON "Next" ID MapNext AT (4 143 36 13) RECTFRAME USABLE
  BUTTON "Edit" ID MapEdit AT (43 143 36 13) RECTFRAME USABLE
  BUTTON "New" ID MapNew AT (82 143 36 13) RECTFRAME USABLE
  BUTTON "Back" ID MapBack AT (121 143 36 13) RECTFRAME USABLE
END

FORM ID NewGameForm AT (0 0 160 160)
USABLE
MENUID MainMenu
BEGIN
  TITLE "New game"
  LABEL "Game type" AUTOID AT (7 27)
  POPUPTRIGGER "Open" ID NgTypeTrig AT (70 27 86 12) LEFTANCHOR
  LIST "Open" "Tournament" "Strict tournament" ID NgTypeList AT (70 27 86 36) NONUSABLE VISIBLEITEMS 3
  POPUPLIST ID NgTypeTrig NgTypeList
  CHECKBOX "Hidden mines" ID NgMines AT (7 44 100 12)
  LABEL "Time limit" AUTOID AT (7 61)
  POPUPTRIGGER "Off" ID NgTimeTrig AT (70 61 86 12) LEFTANCHOR
  LIST "Off" "5 minutes" "10 minutes" "15 minutes" "30 minutes" ID NgTimeList AT (70 61 86 60) NONUSABLE VISIBLEITEMS 5
  POPUPLIST ID NgTimeTrig NgTimeList
  LABEL "Bots" AUTOID AT (7 78)
  POPUPTRIGGER "3" ID NgBotsTrig AT (70 78 86 12) LEFTANCHOR
  LIST "0" "1" "2" "3" "4" "5" "6" "7" ID NgBotsList AT (70 78 30 88) NONUSABLE VISIBLEITEMS 8
  POPUPLIST ID NgBotsTrig NgBotsList
  LABEL "Bot level" AUTOID AT (7 95)
  POPUPTRIGGER "Normal" ID NgLevelTrig AT (70 95 86 12) LEFTANCHOR
  LIST "Easy" "Normal" "Hard" ID NgLevelList AT (70 95 60 36) NONUSABLE VISIBLEITEMS 3
  POPUPLIST ID NgLevelTrig NgLevelList
  LABEL "Teams" AUTOID AT (7 112)
  POPUPTRIGGER "No teams" ID NgTeamsTrig AT (70 112 86 12) LEFTANCHOR
  LIST "No teams" "Teams" ID NgTeamsList AT (70 112 86 24) NONUSABLE VISIBLEITEMS 2
  POPUPLIST ID NgTeamsTrig NgTeamsList
  BUTTON "Start" ID NgStart AT (7 143 46 13) RECTFRAME USABLE
  BUTTON "Host" ID NgHost AT (57 143 46 13) RECTFRAME USABLE
  BUTTON "Back" ID NgBack AT (110 143 46 13) RECTFRAME USABLE
END

FORM ID LobbyForm AT (0 0 160 160)
USABLE
MENUID MainMenu
BEGIN
  TITLE "Host game"
  LABEL "Link" AUTOID AT (7 25)
  POPUPTRIGGER "" ID LobLinkTrig AT (32 25 70 12) LEFTANCHOR
  LIST "" ID LobLinkList AT (32 25 70 24) NONUSABLE VISIBLEITEMS 1
  POPUPLIST ID LobLinkTrig LobLinkList
  BUTTON "Address" ID LobAddress AT (108 25 46 11) RECTFRAME NONUSABLE
  BUTTON "Start" ID LobStart AT (4 143 60 13) RECTFRAME USABLE
  BUTTON "Cancel" ID LobCancel AT (96 143 60 13) RECTFRAME USABLE
END

FORM ID JoinForm AT (0 0 160 160)
USABLE
MENUID MainMenu
BEGIN
  TITLE "Join game"
  LABEL "Link" AUTOID AT (7 25)
  POPUPTRIGGER "" ID JoinLinkTrig AT (43 25 100 12) LEFTANCHOR
  LIST "" ID JoinLinkList AT (43 25 100 12) NONUSABLE VISIBLEITEMS 1
  POPUPLIST ID JoinLinkTrig JoinLinkList
  BUTTON "Join" ID JoinGo AT (4 143 60 13) RECTFRAME USABLE
  BUTTON "Back" ID JoinBack AT (96 143 60 13) RECTFRAME USABLE
END

FORM ID NetSetupForm AT (0 20 160 108)
MODAL
USABLE
BEGIN
  TITLE "Network"
  LABEL "Host IPv4" ID NetSetupAddressLabel AT (7 22)
  FIELD ID NetSetupAddress AT (7 36 145 12) USABLE EDITABLE UNDERLINED SINGLELINE MAXCHARS 15
  LABEL "UDP port" AUTOID AT (7 55)
  FIELD ID NetSetupPort AT (65 55 55 12) USABLE EDITABLE UNDERLINED SINGLELINE MAXCHARS 5 NUMERIC
  BUTTON "OK" ID NetSetupOK AT (7 85 60 13) RECTFRAME USABLE
  BUTTON "Cancel" ID NetSetupCancel AT (94 85 60 13) RECTFRAME USABLE
  GRAFFITISTATEINDICATOR AT (76 87)
END

NAVIGATION ID NetSetupForm
  INITIALSTATE 1
  INITIALOBJECTID NetSetupAddress
BEGIN
  ID NetSetupAddress BELOW NetSetupPort
  ID NetSetupPort ABOVE NetSetupAddress BELOW NetSetupOK
  ID NetSetupOK ABOVE NetSetupPort
  ID NetSetupCancel ABOVE NetSetupPort
END

FORM ID SettingsForm AT (0 0 160 160)
USABLE
MENUID MainMenu
BEGIN
  TITLE "Settings"
  LABEL "Name" AUTOID AT (7 26)
  FIELD ID SetName AT (43 26 110 12) USABLE EDITABLE UNDERLINED SINGLELINE MAXCHARS 15
  CHECKBOX "Sound" ID SetSound AT (7 43 100 12)
  CHECKBOX "Auto slowdown" ID SetSlow AT (7 57 100 12)
  CHECKBOX "Auto gunsight" ID SetSight AT (7 71 100 12)
  BUTTON "1" ID SetKey1 AT (7 101 67 13) RECTFRAME USABLE
  BUTTON "2" ID SetKey2 AT (86 101 67 13) RECTFRAME USABLE
  BUTTON "3" ID SetKey3 AT (7 120 67 13) RECTFRAME USABLE
  BUTTON "4" ID SetKey4 AT (86 120 67 13) RECTFRAME USABLE
  GRAFFITISTATEINDICATOR AT (75 146)
  BUTTON "OK" ID SetOK AT (4 143 60 13) RECTFRAME USABLE
  BUTTON "Cancel" ID SetCancel AT (96 143 60 13) RECTFRAME USABLE
END

NAVIGATION ID SettingsForm
  INITIALSTATE 1
  INITIALOBJECTID SetName
BEGIN
  ID SetName BELOW SetSound
  ID SetSound ABOVE SetName BELOW SetSlow
  ID SetSlow ABOVE SetSound BELOW SetSight
  ID SetSight ABOVE SetSlow BELOW SetKey1
  ID SetKey1 ABOVE SetSight BELOW SetKey3
  ID SetKey2 ABOVE SetSight BELOW SetKey4
  ID SetKey3 ABOVE SetKey1 BELOW SetOK
  ID SetKey4 ABOVE SetKey2 BELOW SetCancel
  ID SetOK ABOVE SetKey3
  ID SetCancel ABOVE SetKey4
END

FORM ID ResultsForm AT (0 0 160 160)
USABLE
BEGIN
  TITLE "Time is up"
  BUTTON "OK" ID ResultsOK AT (50 143 60 13) RECTFRAME USABLE
END

FORM ID GameForm AT (0 0 160 160)
NOFRAME
USABLE
MENUID GameMenu
BEGIN
END

DATA "Mapd" ID EverardMapRes "../res/everard.map"

// The art's bitmap families, made from res/art by tools/art2palm.py.
#include "art.rcp"

MENU ID MainMenu
BEGIN
  PULLDOWN "Game"
  BEGIN
    MENUITEM "About PalmBolo" ID MainMenuAbout
#ifdef DEBUG
    MENUITEM "Self-test" ID MainMenuSelfTest
#endif
    MENUITEM "Quit" ID MainMenuQuit
  END
END

MENU ID GameMenu
BEGIN
  PULLDOWN "Game"
  BEGIN
    MENUITEM "Title" ID MainMenuTitle
    MENUITEM "About PalmBolo" ID MainMenuAbout
    MENUITEM "Quit" ID MainMenuQuit
  END
END

ALERT ID AboutAlert
INFORMATION
BEGIN
  TITLE "About PalmBolo"
  MESSAGE "PalmBolo ^1\nBolo for Palm OS. GPLv3."
  BUTTONS "OK"
END

ALERT ID RomIncompatibleAlert
ERROR
BEGIN
  TITLE "System Incompatible"
  MESSAGE "PalmBolo needs Palm OS 3.0 or later."
  BUTTONS "OK"
END

ALERT ID MapErrorAlert
ERROR
BEGIN
  TITLE "Map"
  MESSAGE "^1: ^2^3"
  BUTTONS "OK"
END

ALERT ID ViewAlert
ERROR
BEGIN
  TITLE "PalmBolo"
  MESSAGE "^1^2^3"
  BUTTONS "OK"
END

ALERT ID JoinAlert
INFORMATION
BEGIN
  TITLE "Join game"
  MESSAGE "Coming later."
  BUTTONS "OK"
END

ALERT ID ReplaceAlert
CONFIRMATION
BEGIN
  TITLE "New game"
  MESSAGE "This replaces the saved game."
  BUTTONS "OK" "Cancel"
END

ALERT ID ResumeAlert
ERROR
BEGIN
  TITLE "Resume"
  MESSAGE "The saved game can't be opened."
  BUTTONS "OK"
END

ALERT ID SaveFailAlert
ERROR
BEGIN
  TITLE "Save"
  MESSAGE "Not enough memory to save the game."
  BUTTONS "OK"
END

MENU ID MapMenu
BEGIN
 PULLDOWN "Map"
 BEGIN
  MENUITEM "Import from card" ID MapImportItem
  MENUITEM "Beam map" ID MapBeamItem
  MENUITEM "Next maps" ID MapPageItem
 END
END
FORM ID MapCardForm AT (2 2 156 156)
MODAL USABLE
BEGIN
 TITLE "Card maps"
 LABEL "                        " ID MapCardPath AT (5 17)
 LIST "" ID MapCardList AT (5 31 144 77) VISIBLEITEMS 7
 BUTTON "Up" ID MapCardUp AT (5 112 35 13) RECTFRAME USABLE
 BUTTON "More" ID MapCardMore AT (44 112 45 13) RECTFRAME USABLE
 BUTTON "Card" ID MapCardVolume AT (94 112 50 13) RECTFRAME USABLE
 BUTTON "Open" ID MapCardOpen AT (5 135 55 13) RECTFRAME USABLE
 BUTTON "Cancel" ID MapCardCancel AT (94 135 55 13) RECTFRAME USABLE
END
ALERT ID MapIoAlert
INFORMATION
BEGIN
 TITLE "Maps"
 MESSAGE "^1"
 BUTTONS "OK"
END

FORM ID MapCopyForm AT (10 45 140 65)
MODAL USABLE
BEGIN
 TITLE "Importing map"
 BUTTON "Cancel" ID MapCopyCancel AT (40 38 60 13) RECTFRAME USABLE
END

// NetAsk (front.c): a message that keeps a network game's link going.
FORM ID NetAskForm AT (2 70 156 88)
MODAL SAVEBEHIND USABLE
BEGIN
  TITLE "PalmBolo"
  FIELD ID NetAskText AT (6 16 144 48) USABLE NONEDITABLE MULTIPLELINES MAXCHARS 80
  BUTTON "Cancel" ID NetAskYes AT (6 70 50 12) RECTFRAME USABLE
  BUTTON "Cancel" ID NetAskNo AT (62 70 50 12) RECTFRAME USABLE
END

ALERT ID OfflineAlert
CONFIRMATION
BEGIN
  TITLE "Continue offline"
  MESSAGE "Continue this game against bots? You cannot rejoin the network game."
  BUTTONS "Continue" "Discard"
END

ALERT ID OfflineSaveAlert
CONFIRMATION
BEGIN
  TITLE "Offline save"
  MESSAGE "Replace the saved game when you leave? Keeping it means this game will not be saved."
  BUTTONS "Replace" "Keep old save"
END

// The map editor (editor.c). The list is the picker, in the order of
// map_edit_terrain (src/game/mapedit.c), then the items.
FORM ID EditForm AT (0 0 160 160)
NOFRAME
USABLE
MENUID EditMenu
BEGIN
  LIST "Grass" "Forest" "Road" "Building" "Shot building" "Rubble" "Crater" "Swamp" "River" "Boat" "Deep sea" "Mined grass" "Mined forest" "Mined road" "Mined rubble" "Mined crater" "Mined swamp" "Pill" "Base" "Start" "Erase item" ID EditTerrainList AT (40 4 80 132) NONUSABLE VISIBLEITEMS 12
  LIST "Paint" "Paint 3x3" "Paint 5x5" "Fill" "Box" ID EditToolList AT (30 4 60 55) NONUSABLE VISIBLEITEMS 5
END

MENU ID EditMenu
BEGIN
  PULLDOWN "Map"
  BEGIN
    MENUITEM "Save" ID EditSaveItem "S"
    MENUITEM "Whole map" ID EditZoomItem "W"
    MENUITEM "Test play" ID EditTestItem "T"
    MENUITEM "Leave editor" ID EditLeaveItem
  END
  PULLDOWN "Edit"
  BEGIN
    MENUITEM "Undo" ID EditUndoItem "U"
    MENUITEM "Item settings" ID EditItemItem "I"
  END
END

FORM ID EditNameForm AT (2 56 156 70)
MODAL
USABLE
DEFAULTBTNID EditNameCancel
BEGIN
  TITLE "Save map"
  LABEL "Name" AUTOID AT (7 22)
  FIELD ID EditNameField AT (36 22 114 12) USABLE EDITABLE UNDERLINED SINGLELINE MAXCHARS 31
  BUTTON "Save" ID EditNameOK AT (7 50 50 13) RECTFRAME USABLE
  BUTTON "Cancel" ID EditNameCancel AT (63 50 50 13) RECTFRAME USABLE
  GRAFFITISTATEINDICATOR AT (132 52)
END

NAVIGATION ID EditNameForm
  INITIALSTATE 1
  INITIALOBJECTID EditNameField
BEGIN
  ID EditNameField BELOW EditNameOK
  ID EditNameOK ABOVE EditNameField
  ID EditNameCancel ABOVE EditNameField
END

ALERT ID EditCheckAlert
ERROR
BEGIN
  TITLE "Save map"
  MESSAGE "^1^2^3"
  BUTTONS "OK"
END

ALERT ID EditLeaveAlert
CONFIRMATION
BEGIN
  TITLE "Leave editor"
  MESSAGE "Save the changes to this map?"
  BUTTONS "Save" "Discard" "Cancel"
END

ALERT ID EditReplaceAlert
CONFIRMATION
BEGIN
  TITLE "Save map"
  MESSAGE "Replace the map ^1?"
  BUTTONS "Replace" "Cancel"
END

// The island size for a new map, the buttons in MAP_BLANK_ order.
FORM ID EditSizeForm AT (2 98 156 60)
MODAL
USABLE
DEFAULTBTNID EditSizeCancel
BEGIN
  TITLE "New map"
  BUTTON "Small" ID EditSizeSmall AT (7 20 44 13) RECTFRAME USABLE
  BUTTON "Medium" ID EditSizeMedium AT (56 20 44 13) RECTFRAME USABLE
  BUTTON "Large" ID EditSizeLarge AT (105 20 44 13) RECTFRAME USABLE
  BUTTON "Cancel" ID EditSizeCancel AT (7 41 44 13) RECTFRAME USABLE
END

ALERT ID EditNoUndoAlert
CONFIRMATION
BEGIN
  TITLE "Map editor"
  MESSAGE "Not enough memory to undo this. Go ahead?"
  BUTTONS "OK" "Cancel"
END

ALERT ID EditItemAlert
INFORMATION
BEGIN
  TITLE "Map editor"
  MESSAGE "^1^2^3"
  BUTTONS "OK"
END

// A pill's or base's owner and stock, or a start's direction. editor.c
// hides the rows the item doesn't have. The facing list runs clockwise
// from north.
FORM ID EditItemForm AT (2 58 156 100)
MODAL
USABLE
DEFAULTBTNID EditItemCancel
BEGIN
  TITLE "Item"
  LABEL "Owner" ID EditOwnerLabel AT (7 18)
  POPUPTRIGGER "Neutral" ID EditOwnerTrigger AT (56 18 70 AUTO) LEFTANCHOR
  LIST "Neutral" "Player 1" "Player 2" "Player 3" "Player 4" "Player 5" "Player 6" "Player 7" "Player 8" "Player 9" "Player 10" "Player 11" "Player 12" "Player 13" "Player 14" "Player 15" "Player 16" ID EditOwnerList AT (60 1 60 99) NONUSABLE VISIBLEITEMS 9
  POPUPLIST ID EditOwnerTrigger EditOwnerList
  LABEL "Facing" ID EditFacingLabel AT (7 18)
  POPUPTRIGGER "N" ID EditFacingTrigger AT (56 18 50 AUTO) LEFTANCHOR
  LIST "N" "NNE" "NE" "ENE" "E" "ESE" "SE" "SSE" "S" "SSW" "SW" "WSW" "W" "WNW" "NW" "NNW" ID EditFacingList AT (60 1 40 99) NONUSABLE VISIBLEITEMS 9
  POPUPLIST ID EditFacingTrigger EditFacingList
  LABEL "Armour" ID EditArmourLabel AT (7 33)
  FIELD ID EditArmourField AT (60 33 20 12) USABLE EDITABLE UNDERLINED SINGLELINE NUMERIC MAXCHARS 2
  LABEL "Shells" ID EditShellsLabel AT (7 48)
  FIELD ID EditShellsField AT (60 48 20 12) USABLE EDITABLE UNDERLINED SINGLELINE NUMERIC MAXCHARS 2
  LABEL "Mines" ID EditMinesLabel AT (7 63)
  FIELD ID EditMinesField AT (60 63 20 12) USABLE EDITABLE UNDERLINED SINGLELINE NUMERIC MAXCHARS 2
  BUTTON "OK" ID EditItemOK AT (7 82 50 13) RECTFRAME USABLE
  BUTTON "Cancel" ID EditItemCancel AT (63 82 50 13) RECTFRAME USABLE
  GRAFFITISTATEINDICATOR AT (132 84)
END
