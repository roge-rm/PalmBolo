#include "resource.h"

VERSION ID 1 kAppVersion

FORM ID TitleForm AT (0 0 160 160)
NOFRAME
USABLE
MENUID MainMenu
BEGIN
  BUTTON "Resume" ID TitleResume AT (4 113 74 14) USABLE
  BUTTON "New game" ID TitleNew AT (82 113 74 14) USABLE
  BUTTON "Join game" ID TitleJoin AT (4 130 74 14) USABLE
  BUTTON "Settings" ID TitleSettings AT (82 130 74 14) USABLE
END

FORM ID MapListForm AT (0 0 160 160)
USABLE
MENUID MainMenu
BEGIN
  TITLE "New game: map"
  LIST "" ID MapList AT (2 18 156 121) VISIBLEITEMS 11
  BUTTON "Next" ID MapNext AT (4 144 60 13) USABLE
  BUTTON "Back" ID MapBack AT (96 144 60 13) USABLE
END

FORM ID NewGameForm AT (0 0 160 160)
USABLE
MENUID MainMenu
BEGIN
  TITLE "New game"
  LABEL "Game type" AUTOID AT (4 20)
  POPUPTRIGGER "Open" ID NgTypeTrig AT (70 20 86 12) LEFTANCHOR
  LIST "Open" "Tournament" "Strict tournament" ID NgTypeList AT (70 20 86 36) NONUSABLE VISIBLEITEMS 3
  POPUPLIST ID NgTypeTrig NgTypeList
  CHECKBOX "Hidden mines" ID NgMines AT (4 36 100 12)
  LABEL "Time limit" AUTOID AT (4 52)
  POPUPTRIGGER "Off" ID NgTimeTrig AT (70 52 86 12) LEFTANCHOR
  LIST "Off" "5 minutes" "10 minutes" "15 minutes" "30 minutes" ID NgTimeList AT (70 52 86 60) NONUSABLE VISIBLEITEMS 5
  POPUPLIST ID NgTimeTrig NgTimeList
  LABEL "Bots" AUTOID AT (4 68)
  POPUPTRIGGER "3" ID NgBotsTrig AT (70 68 86 12) LEFTANCHOR
  LIST "0" "1" "2" "3" "4" "5" "6" "7" ID NgBotsList AT (70 68 30 88) NONUSABLE VISIBLEITEMS 8
  POPUPLIST ID NgBotsTrig NgBotsList
  LABEL "Bot level" AUTOID AT (4 84)
  POPUPTRIGGER "Normal" ID NgLevelTrig AT (70 84 86 12) LEFTANCHOR
  LIST "Easy" "Normal" "Hard" ID NgLevelList AT (70 84 60 36) NONUSABLE VISIBLEITEMS 3
  POPUPLIST ID NgLevelTrig NgLevelList
  LABEL "Teams" AUTOID AT (4 100)
  POPUPTRIGGER "Everyone alone" ID NgTeamsTrig AT (70 100 86 12) LEFTANCHOR
  LIST "Everyone alone" "Teams" ID NgTeamsList AT (70 100 86 24) NONUSABLE VISIBLEITEMS 2
  POPUPLIST ID NgTeamsTrig NgTeamsList
  BUTTON "Start" ID NgStart AT (4 144 46 13) USABLE
  BUTTON "Host" ID NgHost AT (57 144 46 13) USABLE
  BUTTON "Back" ID NgBack AT (110 144 46 13) USABLE
END

FORM ID LobbyForm AT (0 0 160 160)
USABLE
MENUID MainMenu
BEGIN
  TITLE "Host game"
  LABEL "Link" AUTOID AT (4 16)
  POPUPTRIGGER "" ID LobLinkTrig AT (28 16 100 12) LEFTANCHOR
  LIST "" ID LobLinkList AT (28 16 100 12) NONUSABLE VISIBLEITEMS 1
  POPUPLIST ID LobLinkTrig LobLinkList
  BUTTON "Start" ID LobStart AT (4 144 60 13) USABLE
  BUTTON "Cancel" ID LobCancel AT (96 144 60 13) USABLE
END

FORM ID JoinForm AT (0 0 160 160)
USABLE
MENUID MainMenu
BEGIN
  TITLE "Join game"
  LABEL "Link" AUTOID AT (4 16)
  POPUPTRIGGER "" ID JoinLinkTrig AT (28 16 100 12) LEFTANCHOR
  LIST "" ID JoinLinkList AT (28 16 100 12) NONUSABLE VISIBLEITEMS 1
  POPUPLIST ID JoinLinkTrig JoinLinkList
  BUTTON "Join" ID JoinGo AT (4 144 60 13) USABLE
  BUTTON "Back" ID JoinBack AT (96 144 60 13) USABLE
END

FORM ID SettingsForm AT (0 0 160 160)
USABLE
MENUID MainMenu
BEGIN
  TITLE "Settings"
  LABEL "Name" AUTOID AT (4 20)
  FIELD ID SetName AT (40 20 116 12) USABLE EDITABLE UNDERLINED SINGLELINE MAXCHARS 15
  CHECKBOX "Sound" ID SetSound AT (4 38 100 12)
  CHECKBOX "Auto slowdown" ID SetSlow AT (4 52 100 12)
  CHECKBOX "Auto gunsight" ID SetSight AT (4 66 100 12)
  LABEL "Buttons" AUTOID AT (4 84)
  BUTTON "1" ID SetKey1 AT (4 98 74 13) USABLE
  BUTTON "2" ID SetKey2 AT (82 98 74 13) USABLE
  BUTTON "3" ID SetKey3 AT (4 114 74 13) USABLE
  BUTTON "4" ID SetKey4 AT (82 114 74 13) USABLE
  GRAFFITISTATEINDICATOR AT (75 146)
  BUTTON "OK" ID SetOK AT (4 144 60 13) USABLE
  BUTTON "Cancel" ID SetCancel AT (96 144 60 13) USABLE
END

FORM ID ResultsForm AT (0 0 160 160)
USABLE
BEGIN
  TITLE "Time is up"
  BUTTON "OK" ID ResultsOK AT (50 144 60 13) USABLE
END

FORM ID GameForm AT (0 0 160 160)
NOFRAME
USABLE
MENUID GameMenu
BEGIN
END

DATA "Mapd" ID EverardMapRes "../res/everard.map"

// The art's bitmap families, made from res/art by tools/art2palm.py.
#include "art.rcp"

MENU ID MainMenu
BEGIN
  PULLDOWN "Game"
  BEGIN
    MENUITEM "About PalmBolo" ID MainMenuAbout
#ifdef DEBUG
    MENUITEM "Self-test" ID MainMenuSelfTest
#endif
    MENUITEM "Quit" ID MainMenuQuit
  END
END

MENU ID GameMenu
BEGIN
  PULLDOWN "Game"
  BEGIN
    MENUITEM "Title" ID MainMenuTitle
    MENUITEM "About PalmBolo" ID MainMenuAbout
    MENUITEM "Quit" ID MainMenuQuit
  END
END

ALERT ID AboutAlert
INFORMATION
BEGIN
  TITLE "About PalmBolo"
  MESSAGE "PalmBolo ^1\nBolo for Palm OS. GPLv3."
  BUTTONS "OK"
END

ALERT ID RomIncompatibleAlert
ERROR
BEGIN
  TITLE "System Incompatible"
  MESSAGE "PalmBolo needs Palm OS 3.0 or later."
  BUTTONS "OK"
END

ALERT ID MapErrorAlert
ERROR
BEGIN
  TITLE "Map"
  MESSAGE "^1: ^2^3"
  BUTTONS "OK"
END

ALERT ID ViewAlert
ERROR
BEGIN
  TITLE "PalmBolo"
  MESSAGE "^1^2^3"
  BUTTONS "OK"
END

ALERT ID JoinAlert
INFORMATION
BEGIN
  TITLE "Join game"
  MESSAGE "Coming later."
  BUTTONS "OK"
END

ALERT ID ReplaceAlert
CONFIRMATION
BEGIN
  TITLE "New game"
  MESSAGE "This replaces the saved game."
  BUTTONS "OK" "Cancel"
END

ALERT ID ResumeAlert
ERROR
BEGIN
  TITLE "Resume"
  MESSAGE "The saved game can't be opened."
  BUTTONS "OK"
END

ALERT ID SaveFailAlert
ERROR
BEGIN
  TITLE "Save"
  MESSAGE "Not enough memory to save the game."
  BUTTONS "OK"
END
