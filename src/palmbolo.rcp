#include "resource.h"

VERSION ID 1 "0.1"
ICON "../res/icon.bmp"
SMALLICON "../res/smallicon.bmp"

FORM ID MapListForm AT (0 0 160 160)
USABLE
MENUID MainMenu
BEGIN
  TITLE "PalmBolo maps"
  LIST "" ID MapList AT (2 18 156 140) VISIBLEITEMS 12
END

FORM ID GameForm AT (0 0 160 160)
NOFRAME
USABLE
MENUID MainMenu
BEGIN
END

DATA "Mapd" ID EverardMapRes "../res/everard.map"

// The art's bitmap families, made from res/art by tools/art2palm.py.
#include "art.rcp"

MENU ID MainMenu
BEGIN
  PULLDOWN "Game"
  BEGIN
    MENUITEM "Map list" ID MainMenuMaps
    MENUITEM "About PalmBolo" ID MainMenuAbout
#ifdef DEBUG
    MENUITEM "Self-test" ID MainMenuSelfTest
#endif
    MENUITEM "Quit" ID MainMenuQuit
  END
  PULLDOWN "Options"
  BEGIN
    MENUITEM "Sound on" ID MainMenuSoundOn
    MENUITEM "Sound off" ID MainMenuSoundOff
  END
END

ALERT ID AboutAlert
INFORMATION
BEGIN
  TITLE "About PalmBolo"
  MESSAGE "PalmBolo 0.1\nBolo for Palm OS. GPLv3."
  BUTTONS "OK"
END

ALERT ID RomIncompatibleAlert
ERROR
BEGIN
  TITLE "System Incompatible"
  MESSAGE "PalmBolo needs Palm OS 3.0 or later."
  BUTTONS "OK"
END

ALERT ID MapErrorAlert
ERROR
BEGIN
  TITLE "Map"
  MESSAGE "^1: ^2^3"
  BUTTONS "OK"
END

ALERT ID ViewAlert
ERROR
BEGIN
  TITLE "PalmBolo"
  MESSAGE "^1^2^3"
  BUTTONS "OK"
END
